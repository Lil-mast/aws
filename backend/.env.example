# ─────────────────────────────────────────────
# Mula API
# ─────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────
# Database — NeonDB (PostgreSQL)
# Get your connection string from https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# Keep the URL private. Runtime converts it to asyncpg automatically.
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────
# AWS Bedrock (AI features)
# ─────────────────────────────────────────────
AI_PROVIDER=local
BEDROCK_REGION=us-east-1
BEDROCK_NOVA_LITE_MODEL_ID=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0
BEDROCK_NOVA_MICRO_MODEL_ID=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-micro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional Bedrock bearer API key. Use this OR the IAM access-key pair above.
AWS_BEARER_TOKEN_BEDROCK=

# ─────────────────────────────────────────────
# Redis / Celery
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ─────────────────────────────────────────────
# Paystack
# ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ─────────────────────────────────────────────
# Mula Score Engine
# ─────────────────────────────────────────────
SCORE_ENGINE_VERSION=1
