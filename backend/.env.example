# ─────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────
SECRET_KEY=your_django_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────
# Database — NeonDB (PostgreSQL)
# Get your connection string from https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-1.aws.neon.tech/hela?sslmode=require

# ─────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────
# AWS Bedrock (AI features)
# ─────────────────────────────────────────────
AI_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_NOVA_LITE_MODEL_ID=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0
BEDROCK_NOVA_MICRO_MODEL_ID=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-micro-v1:0
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ─────────────────────────────────────────────
# Redis / Celery
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ─────────────────────────────────────────────
# Paystack
# ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ─────────────────────────────────────────────
# Hela Score Engine
# ─────────────────────────────────────────────
SCORE_ENGINE_VERSION=1
SCORE_RECALC_SCHEDULE=daily
